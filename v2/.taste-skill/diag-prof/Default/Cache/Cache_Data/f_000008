  function buildPlainTextSpecs() {
    const m = computeMetrics();
    const lid = LID_MODULES[state.lidModule] || LID_MODULES.solar;
    const lines = [
      'KING OF KOOLERS — CONFIGURED 3D BUILD SHEET',
      '============================================',
      `Diameter: 24.0" OD (3.5" R-8 Polyurethane Foam Walls)`,
      `Stack Height: ${m.heightIn.toFixed(1)}" (${m.heightCm} cm) / 72.0" Max`,
      `Total Capacity: ${m.quarts} QT · ${m.cans} x 12 oz cans (2:1 ice ratio)`,
      `Weight: ${m.dryLbs} lbs dry · ${m.fullLoadedLbs} lbs full loaded (2:1 ice)`,
      `Seat Load Rating: 500 lb static compressive top load`,
      '',
      'MODULES (TOP TO BASE):'
    ];
    for (let i = state.tiers.length - 1; i >= 0; i--) {
      const t = state.tiers[i];
      const cat = TIERS_CATALOG[t.height] || TIERS_CATALOG[20];
      const col = COLORWAYS[t.color] || COLORWAYS.blue;
      const drain = cat.allowsSpigot && i === 0 && state.showSpigot ? ' + Quarter-Turn Spigot' : '';
      lines.push(`- ${cat.name} | ${col.name} (${col.hex}) | ${cat.quarts} QT${drain} | $${cat.price}`);
    }
    lines.push('');
    lines.push(`Crown Lid: ${lid.name} (${lid.price > 0 ? `+$${lid.price}` : 'Included'})`);
    lines.push(`Wagon Base: ${state.showWagon ? `3-Wheel All-Terrain Dolly (+$${WAGON_PRICE})` : 'Standard Concentric Foot'}`);
    lines.push(`Deli Carousel: ${state.showCarousel ? 'Included' : 'Omitted'}`);
    if (m.hasEngraving) {
      lines.push(`Engraving (${state.engraveLoc}): ${state.engraveLine1} / ${state.engraveLine2}`);
    }
    lines.push(`Estimated Total: $${m.totalPrice.toFixed(2)}`);
    return lines.join('\n');
  }

  function saveCustomizationPayload() {
    try {
      const m = computeMetrics();
      const payload = {
        mode: state.mode,
        stackType: state.activePresetKey,
        stackLabel: isV12Mode() ? `V12 CAD (${state.v12HeightIn}")` : `${m.tierCount}-Tier Stack (${m.heightIn}")`,
        tiers: state.tiers.map((t) => ({ height: t.height, color: t.color })),
        heightIn: m.heightIn,
        quarts: m.quarts,
        cansCount: m.cans,
        dryLbs: m.dryLbs,
        loadedLbs: m.fullLoadedLbs,
        estimatedPrice: m.totalPrice,
        lidModule: state.lidModule,
        showSpigot: m.spigotActive,
        showWagon: state.showWagon,
        engraveLoc: state.engraveLoc,
        engraveLine1: state.engraveLine1,
        engraveLine2: state.engraveLine2,
        applyPending: true,
        timestamp: Date.now()
      };
      localStorage.setItem('kok_studio_customization', JSON.stringify(payload));
    } catch (err) {
      console.warn('localStorage save skipped:', err);
    }
  }

  function downloadStudioSnapshot() {
    if (!webglReady || !renderer) {
      showToast('WebGL snapshot is unavailable without hardware canvas.');
      return;
    }
    renderer.render(scene, camera);
    const url = renderer.domElement.toDataURL('image/png');
    const a = document.createElement('a');
    a.download = `KingOfKoolers_3D_Stack_${Date.now()}.png`;
    a.href = url;
    a.click();
    showToast('3D studio snapshot downloaded as PNG.');
  }

  // =========================================================================
  // 12. Wire All Event Listeners
  // =========================================================================
  function bindEvents() {
    // Environment lighting toggle
    document.querySelectorAll('[data-env]').forEach((btn) => {
      btn.addEventListener('click', () => applyEnvironment(btn.dataset.env));
    });

    // Camera presets
    document.querySelectorAll('[data-view]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const view = btn.dataset.view;
        document.querySelectorAll('[data-view]').forEach((b) => {
          b.setAttribute('aria-pressed', String(b === btn && view !== 'reset'));
        });
        if (view === 'reset') {
          const first = document.querySelector('[data-view="three-quarter"]');
          if (first) first.setAttribute('aria-pressed', 'true');
        }
        frameCameraPreset(view);
      });
    });

    // Turntable & Snapshot
    if (btnTurntable) {
      btnTurntable.addEventListener('click', () => {
        state.turntable = !state.turntable;
        btnTurntable.setAttribute('aria-pressed', String(state.turntable));
      });
    }
    if (btnSnapshot) {
      btnSnapshot.addEventListener('click', downloadStudioSnapshot);
    }

    // Presets
    document.querySelectorAll('[data-preset]').forEach((btn) => {
      btn.addEventListener('click', () => applyPreset(btn.dataset.preset));
    });

    // V12 Height Buttons
    document.querySelectorAll('[data-v12-height]').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.v12HeightIn = Number(btn.dataset.v12Height) || 20;
        if (!isV12Mode()) state.mode = 'v12-onepiece';
        rebuildCoolerScene();
        syncAllUI();
        frameCameraPreset('three-quarter');
      });
    });

    // Add tier buttons
    document.querySelectorAll('[data-add-tier]').forEach((btn) => {
      btn.addEventListener('click', () => addTier(btn.dataset.addTier));
    });

    // Color scope & Swatches
    document.querySelectorAll('[data-color-scope]').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.colorScope = btn.dataset.colorScope;
        syncColorwayUI();
      });
    });

    document.querySelectorAll('[data-color]').forEach((card) => {
      card.addEventListener('click', () => {
        const c = card.dataset.color;
        if (!COLORWAYS[c]) return;
        if (state.colorScope === 'all') {
          state.tiers.forEach((t) => { t.color = c; });
        } else {
          const target = state.tiers[state.selectedTierIndex];
          if (target) target.color = c;
        }
        rebuildCoolerScene();
        syncAllUI();
      });
    });

    // Lid Selector
    document.querySelectorAll('[data-lid]').forEach((card) => {
      card.addEventListener('click', () => {
        const lidId = card.dataset.lid;
        if (!LID_MODULES[lidId]) return;
        state.lidModule = lidId;
        rebuildCoolerScene();
        syncAllUI();
      });
    });

    // Explode & Cutaway sliders + buttons
    if (explodeSlider) {
      syncRangeCSS(explodeSlider, '0 percent separated');
      explodeSlider.addEventListener('input', (e) => setExplodePct(e.target.value));
    }
    if (xraySlider) {
      syncRangeCSS(xraySlider, '0 percent cutaway');
      xraySlider.addEventListener('input', (e) => {
        if (state.mode === 'cad-part') activateTab('panel-build');
        setXrayPct(e.target.value);
      });
    }

    const toggleExplode = () => {
      setExplodePct(state.explodeTarget >= 0.5 ? 0 : 100);
      if (state.mode !== 'cad-part') {
        frameCameraPreset('three-quarter');
      }
    };
    const toggleCutaway = () => {
      if (state.mode === 'cad-part') activateTab('panel-build');
      setXrayPct(state.xrayPct > 0 ? 0 : 50);
    };

    if (btnExplodeToggle) btnExplodeToggle.addEventListener('click', toggleExplode);
    if (hudBtnExplode) hudBtnExplode.addEventListener('click', toggleExplode);
    if (btnSliceHalf) btnSliceHalf.addEventListener('click', toggleCutaway);
    if (hudBtnCutaway) hudBtnCutaway.addEventListener('click', toggleCutaway);

    // Switches (preventDefault stops motion.js from double-flipping aria-checked)
    if (swSpigot) {
      swSpigot.addEventListener('click', (e) => {
        e.preventDefault();
        if (!hasBaseSpigotCapability()) return;
        state.showSpigot = !state.showSpigot;
        rebuildCoolerScene();
        syncAllUI();
      });
    }
    if (swWagon) {
      swWagon.addEventListener('click', (e) => {
        e.preventDefault();
        state.showWagon = !state.showWagon;
        rebuildCoolerScene();
        syncAllUI();
      });
    }
    if (swCarousel) {
      swCarousel.addEventListener('click', (e) => {
        e.preventDefault();
        state.showCarousel = !state.showCarousel;
        rebuildCoolerScene();
        syncAllUI();
      });
    }
    if (swIce) {
      swIce.addEventListener('click', (e) => {
        e.preventDefault();
        state.showIceAndCans = !state.showIceAndCans;
        rebuildCoolerScene();
        syncAllUI();
      });
    }

    // Trip Capacity Calculator
    if (partyRange) {
      syncRangeCSS(partyRange);
      partyRange.addEventListener('input', (e) => {
        state.partySize = Number(e.target.value) || 4;
        syncRangeCSS(partyRange);
        updateTripErgonomics();
      });
    }
    if (daysRange) {
      syncRangeCSS(daysRange);
      daysRange.addEventListener('input', (e) => {
        state.tripDays = Number(e.target.value) || 3;
        syncRangeCSS(daysRange);
        updateTripErgonomics();
      });
    }
    if (btnApplyCalc) {
      btnApplyCalc.addEventListener('click', () => {
        const recKey = calcStackResult?.dataset.recKey || 'patriot-58';
        applyPreset(recKey);
        activateTab('panel-build');
        showToast(`Applied ${STACK_PRESETS[recKey].label} to 3D viewport.`);
      });
    }

    // CAD Inspector Controls
    document.querySelectorAll('[data-cad-shader]').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.cadShaderMode = btn.dataset.cadShader;
        document.querySelectorAll('[data-cad-shader]').forEach((b) => {
          b.setAttribute('aria-pressed', String(b === btn));
        });
        if (state.mode !== 'cad-part') {
          state.mode = 'cad-part';
          rebuildCoolerScene();
        } else {
          renderActiveCadPart();
        }
      });
    });

    if (btnCadReturn) {
      btnCadReturn.addEventListener('click', () => activateTab('panel-build'));
    }

    // Laser Engraving
    document.querySelectorAll('[data-engrave-loc]').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.engraveLoc = btn.dataset.engraveLoc;
        document.querySelectorAll('[data-engrave-loc]').forEach((b) => {
          b.setAttribute('aria-pressed', String(b === btn));
        });
        if (state.engraveLoc === 'lid' && state.lidModule !== 'bamboo') {
          state.lidModule = 'bamboo';
        }
        rebuildCoolerScene();
        syncAllUI();
      });
    });

    const handleTextEngrave = () => {
      state.engraveLine1 = inputLine1?.value || '';
      state.engraveLine2 = inputLine2?.value || '';
      if (state.engraveLoc === 'lid' && state.lidModule === 'standard') {
        state.lidModule = 'bamboo';
      }
      rebuildCoolerScene();
      syncAllUI();
    };
    if (inputLine1) inputLine1.addEventListener('input', handleTextEngrave);
    if (inputLine2) inputLine2.addEventListener('input', handleTextEngrave);

    document.querySelectorAll('[data-crest]').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.crest = btn.dataset.crest;
        document.querySelectorAll('[data-crest]').forEach((b) => {
          b.setAttribute('aria-pressed', String(b === btn));
        });
        rebuildCoolerScene();
      });
    });

    if (logoUpload) {
      logoUpload.addEventListener('change', (e) => {
        const file = e.target.files?.[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (ev) => {
          const img = new Image();
          img.onload = () => {
            state.customLogoImg = img;
            if (state.engraveLoc === 'lid') state.lidModule = 'bamboo';
            rebuildCoolerScene();
            syncAllUI();
            showToast('Custom engraving graphic applied.');
          };
          img.src = ev.target.result;
        };
        reader.readAsDataURL(file);
      });
    }

    if (logoClear) {
      logoClear.addEventListener('click', () => {
        state.customLogoImg = null;
        if (logoUpload) logoUpload.value = '';
        rebuildCoolerScene();
        syncAllUI();
      });
    }

    // Build Sheet Native Dialog & Copy Specs
    if (btnOpenSpecSheet && specDialog) {
      btnOpenSpecSheet.addEventListener('click', () => {
        populateSpecSheetDialog();
        if (!('commandForElement' in HTMLButtonElement.prototype) && !specDialog.open) {
          // v2-core handles commandfor polyfill too; safeguard just in case
          specDialog.showModal();
        }
      });
    }

    if (btnCopySpecs) {
      btnCopySpecs.addEventListener('click', async () => {
        const text = buildPlainTextSpecs();
        try {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(text);
          } else {
            throw new Error('Clipboard unavailable');
          }
          showToast('Build sheet copied to clipboard.');
        } catch {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
          showToast('Build sheet copied to clipboard.');
        }
      });
    }

    if (btnModalSnapshot) {
      btnModalSnapshot.addEventListener('click', downloadStudioSnapshot);
    }

    if (btnRailReserve) btnRailReserve.addEventListener('click', saveCustomizationPayload);
    if (btnModalReserve) btnModalReserve.addEventListener('click', saveCustomizationPayload);
  }

  // =========================================================================
  // 13. Bootstrap
  // =========================================================================
  populateCadPartsBrowser();
  updateCadTelemetryUI();
  syncAllUI();
  bindEvents();
  initThreeViewport();

  if (window.location.hash === '#cad-inspector') {
    activateTab('panel-cad');
  }
})();
