  function generateStippleBumpTexture() {
    const cvs = document.createElement('canvas');
    cvs.width = 256;
    cvs.height = 256;
    const ctx = cvs.getContext('2d');
    const imgData = ctx.createImageData(256, 256);
    const d = imgData.data;
    // Deterministic pseudo-random MT-11010 matte grain
    let seed = 1337;
    for (let i = 0; i < d.length; i += 4) {
      seed = (seed * 1664525 + 1013904223) >>> 0;
      const v = 112 + ((seed >>> 24) & 31);
      d[i] = v;
      d[i + 1] = v;
      d[i + 2] = v;
      d[i + 3] = 255;
    }
    ctx.putImageData(imgData, 0, 0);
    const tex = new THREE.CanvasTexture(cvs);
    tex.wrapS = THREE.RepeatWrapping;
    tex.wrapT = THREE.RepeatWrapping;
    tex.repeat.set(6, 3);
    return tex;
  }

  function generateSolarTexture() {
    const cvs = document.createElement('canvas');
    cvs.width = 512;
    cvs.height = 512;
    const ctx = cvs.getContext('2d');
    ctx.fillStyle = '#0F1522';
    ctx.fillRect(0, 0, 512, 512);

    ctx.strokeStyle = 'rgba(210, 220, 232, 0.24)';
    ctx.lineWidth = 2;
    for (let x = 0; x <= 512; x += 64) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, 512);
      ctx.stroke();
    }
    for (let y = 0; y <= 512; y += 64) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(512, y);
      ctx.stroke();
    }
    ctx.strokeStyle = 'rgba(210, 220, 232, 0.1)';
    ctx.lineWidth = 1;
    for (let x = 16; x < 512; x += 32) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, 512);
      ctx.stroke();
    }
    return new THREE.CanvasTexture(cvs);
  }

  function generateEngraveTexture(loc, baseHex = '#1E4BD7') {
    const cvs = document.createElement('canvas');
    cvs.width = 1024;
    cvs.height = 1024;
    const ctx = cvs.getContext('2d');

    if (loc === 'lid') {
      // Warm Acacia & Bamboo end-grain wood rings + perimeter juice groove
      ctx.fillStyle = '#B78C56';
      ctx.fillRect(0, 0, 1024, 1024);

      for (let i = 0; i < 42; i++) {
        ctx.strokeStyle = i % 2 === 0 ? 'rgba(98, 62, 28, 0.14)' : 'rgba(224, 186, 132, 0.12)';
        ctx.beginPath();
        ctx.arc(512, 512, 24 + i * 23, 0, Math.PI * 2);
        ctx.lineWidth = 3 + (i % 4);
        ctx.stroke();
      }
      // Juice groove
      ctx.strokeStyle = 'rgba(72, 44, 18, 0.38)';
      ctx.lineWidth = 14;
      ctx.beginPath();
      ctx.arc(512, 512, 446, 0, Math.PI * 2);
      ctx.stroke();
    } else {
      ctx.fillStyle = baseHex;
      ctx.fillRect(0, 0, 1024, 1024);
    }

    if (state.customLogoImg) {
      ctx.save();
      const maxDim = 220;
      const ratio = Math.min(maxDim / state.customLogoImg.width, maxDim / state.customLogoImg.height);
      const w = state.customLogoImg.width * ratio;
      const h = state.customLogoImg.height * ratio;
      ctx.globalAlpha = loc === 'lid' ? 0.86 : 0.94;
      ctx.drawImage(state.customLogoImg, 512 - w / 2, 250 - h / 2, w, h);
      ctx.restore();
    }

    const l1 = state.engraveLine1.trim();
    const l2 = state.engraveLine2.trim();
    if (l1 || l2) {
      const darkWood = loc === 'lid';
      ctx.fillStyle = darkWood ? 'rgba(42, 24, 10, 0.88)' : (baseHex === '#F0F4FA' ? 'rgba(10, 10, 10, 0.86)' : 'rgba(255, 255, 255, 0.92)');
      ctx.textAlign = 'center';

      const crestMap = {
        crown: '♛',
        stars: '★ ★ ★',
        peaks: '▲ ▲ ▲',
        compass: '✦'
      };
      ctx.font = 'bold 78px sans-serif';
      ctx.fillText(crestMap[state.crest] || '♛', 512, 435);

      if (l1) {
        ctx.font = 'bold 46px "Figtree", system-ui, sans-serif';
        ctx.fillText(l1.toUpperCase(), 512, 540);
      }
      if (l2) {
        ctx.font = '500 26px ui-monospace, monospace';
        ctx.fillText(l2.toUpperCase(), 512, 594);
      }
    }

    return new THREE.CanvasTexture(cvs);
  }

