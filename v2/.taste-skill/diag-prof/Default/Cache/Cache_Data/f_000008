    if (heightMeterFill) {
      heightMeterFill.style.width = `${Math.min(100, (totalHeight / MAX_STACK_HEIGHT) * 100)}%`;
    }

    // Clamp selectedTierIndex safely
    if (state.selectedTierIndex >= state.tiers.length) {
