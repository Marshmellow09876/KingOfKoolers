  // =========================================================================
  // 7. Stack Mutation Actions
  // =========================================================================
  function ensureModularMode() {
    if (isV12Mode() || state.mode === 'cad-part') {
      state.mode = 'modular';
      state.activePresetKey = 'custom';
    }
  }

  function addTier(heightIn) {
    const addH = Number(heightIn);
    if (!TIERS_CATALOG[addH]) return;

    if (isV12Mode()) {
      state.mode = 'modular';
      state.tiers = [makeTier(addH, state.tiers[0]?.color || 'blue')];
      state.selectedTierIndex = 0;
      state.activePresetKey = 'custom';
      rebuildCoolerScene();
      syncAllUI();
      frameCameraPreset('three-quarter');
      return;
    }

    ensureModularMode();
    const currentH = state.tiers.reduce((acc, t) => acc + t.height, 0);
    if (currentH + addH > MAX_STACK_HEIGHT) {
      showToast(`Cannot exceed ${MAX_STACK_HEIGHT}" maximum stack height.`);
      return;
    }

    const colorCycle = ['blue', 'white', 'red', 'charcoal'];
    const nextColor = colorCycle[state.tiers.length % colorCycle.length];
    state.tiers.push(makeTier(addH, nextColor));
    state.selectedTierIndex = state.tiers.length - 1;
    state.activePresetKey = 'custom';

    rebuildCoolerScene();
    syncAllUI();
    frameCameraPreset('three-quarter');
  }

  function removeTier(index) {
    if (state.tiers.length <= 1) return;
    ensureModularMode();
    state.tiers.splice(index, 1);
    state.selectedTierIndex = Math.min(state.selectedTierIndex, state.tiers.length - 1);
    state.activePresetKey = 'custom';
    rebuildCoolerScene();
    syncAllUI();
    frameCameraPreset('three-quarter');
  }

  function moveTier(fromIdx, toIdx) {
    if (toIdx < 0 || toIdx >= state.tiers.length) return;
    ensureModularMode();
    const [moved] = state.tiers.splice(fromIdx, 1);
    state.tiers.splice(toIdx, 0, moved);
    state.selectedTierIndex = toIdx;
    state.activePresetKey = 'custom';
    rebuildCoolerScene();
    syncAllUI();
  }

  function applyPreset(presetKey) {
    const preset = STACK_PRESETS[presetKey];
    if (!preset) return;
    state.activePresetKey = presetKey;
    state.mode = preset.mode;
    if (preset.v12HeightIn) state.v12HeightIn = preset.v12HeightIn;
    state.tiers = preset.tiers.map((t) => makeTier(t.height, t.color));
    state.selectedTierIndex = state.tiers.length - 1;
    state.lidModule = preset.lid;

    rebuildCoolerScene();
    syncAllUI();
    frameCameraPreset('three-quarter');
  }

