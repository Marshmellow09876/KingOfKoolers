    ]);

    Object.values(cad).forEach((part) => {
      if (isSplit) {
        if (!part.inSplitKit) return;
      } else {
        if (part.key === 'v12_one_piece_body' && activeOnePieceKey !== 'v12_one_piece_body' && cad[activeOnePieceKey]) {
          return;
        }
        if (part.key !== activeOnePieceKey && !part.inOnePiece) return;
      }

      if (part.key === 'v12_wagon_base' && !state.showWagon) return;
      if (part.key === 'v12_solar_batteries' && state.lidModule !== 'solar') return;
      if ((part.key === 'v12_top_dish_logo' || part.key === 'v12_lower_dish_hex' || part.key === 'v12_allthread_post') && !state.showCarousel) return;
      if (part.key === 'v12_ice_and_cans' && !state.showIceAndCans) return;

      const geo = decodeCadGeometry(part);
      const isClipped = clippedKeys.has(part.key);

      let mat;
      if (part.key.startsWith('v12_one_piece') || part.key === 'v12_sec2_lower' || part.key === 'v12_sec4_handles') {
        mat = makeLLDPEMaterial(baseHex, isClipped);
      } else if (part.key === 'v12_sec3_mid') {
        mat = makeLLDPEMaterial(isSplit ? midHex : baseHex, isClipped);
      } else if (part.key === 'v12_sec5_collar' || part.key === 'v12_crown_lid') {
        mat = makeLLDPEMaterial(isSplit ? topHex : baseHex, isClipped);
      } else if (part.key === 'v12_sec1_foot' || part.key === 'v12_wagon_base') {
        mat = makeLLDPEMaterial('#1E222B', isClipped);
      } else if (part.key === 'v12_ice_and_cans') {
        mat = new THREE.MeshPhysicalMaterial({
          color: 0xDCEAF5,
          roughness: 0.18,
          metalness: 0.05,
          transmission: 0.35,
          transparent: true,
          opacity: 0.9,
          side: THREE.DoubleSide
        });
      } else if (part.key === 'v12_alignment_pins' || part.key === 'v12_allthread_post') {
        mat = new THREE.MeshStandardMaterial({ color: 0x9CA3AF, roughness: 0.32, metalness: 0.72, side: THREE.DoubleSide });
      } else if (part.key === 'v12_solar_batteries') {
        mat = new THREE.MeshStandardMaterial({ color: 0x1E222B, roughness: 0.45, metalness: 0.28, side: THREE.DoubleSide });
      } else {
        mat = new THREE.MeshStandardMaterial({ color: 0xE5E7EB, roughness: 0.48, metalness: 0.12, side: THREE.DoubleSide });
      }

      const mesh = new THREE.Mesh(geo, mat);
      let scaleY = MM_TO_IN;
      const cx = (part.centerMmYUp ? part.centerMmYUp[0] : 0) * MM_TO_IN;
      let cy = ((part.centerMmYUp ? part.centerMmYUp[1] : 0) * MM_TO_IN) + wagonOffset;
      const cz = (part.centerMmYUp ? part.centerMmYUp[2] : 0) * MM_TO_IN;

      if (deltaIn !== 0) {
        if (part.key === 'v12_crown_lid' || part.key === 'v12_solar_batteries' || part.key === 'v12_sec4_handles' || part.key === 'v12_sec5_collar') {
          cy += deltaIn;
        } else if (part.key === 'v12_sec3_mid') {
          const origMidH = 6.12;
          const newMidH = Math.max(1.2, origMidH + deltaIn);
          scaleY = MM_TO_IN * (newMidH / origMidH);
          cy += deltaIn * 0.5;
        } else if (part.key === 'v12_top_dish_logo') {
          cy += deltaIn * 0.72;
        } else if (part.key === 'v12_lower_dish_hex') {
          cy += deltaIn * 0.32;
        } else if (part.key === 'v12_allthread_post') {
          const origRodH = 14.16;
          const newRodH = Math.max(6.8, origRodH + deltaIn * 0.85);
          scaleY = MM_TO_IN * (newRodH / origRodH);
          cy += (newRodH - origRodH) * 0.5;
        } else if (part.key === 'v12_alignment_pins') {
          const origPinSpan = 16.59;
          const newPinSpan = Math.max(8.5, origPinSpan + deltaIn);
          scaleY = MM_TO_IN * (newPinSpan / origPinSpan);
          cy += deltaIn * 0.5;
        }
      }

      mesh.scale.set(MM_TO_IN, scaleY, MM_TO_IN);
      mesh.position.set(cx, cy, cz);
      mesh.castShadow = true;
      mesh.receiveShadow = true;

      const layer = typeof part.explodeLayer === 'number' ? part.explodeLayer : 2.0;
      mesh.userData = {
        partKey: part.key,
        baseY: cy,
        explodeDeltaY: (layer - 1.2) * 3.8
      };

      v12AssemblyGroup.add(mesh);
      v12ExplodableMeshes.push(mesh);
    });
  }

  function rebuildCoolerScene() {
    if (!webglReady) return;

    disposeGroupChildren(modularGroup);
    disposeGroupChildren(v12AssemblyGroup);
    buildWagonBase();

    tierGroups = [];
    v12ExplodableMeshes = [];
    foamSectionSlices = [];

    if (state.mode === 'cad-part') {
      coolerRoot.visible = false;
      cadInspectorGroup.visible = true;
      renderActiveCadPart();
      return;
    }

    coolerRoot.visible = true;
    cadInspectorGroup.visible = false;

    if (isV12Mode()) {
      buildV12CadAssembly();
      applyCutawayPlane(state.xrayPct);
      return;
    }

    const wagonOffset = state.showWagon ? 2.43 : 0;
    let runningY = wagonOffset;

    state.tiers.forEach((tier, idx) => {
      const tGroup = buildModularTier(tier, idx, state.tiers.length);
      tGroup.position.y = runningY;
      modularGroup.add(tGroup);
      tierGroups.push({
        group: tGroup,
        baseY: runningY,
        height: tier.height,
        index: idx
      });
      runningY += tier.height;
    });

    const lid = buildLidAssembly();
    lid.position.y = runningY;
    modularGroup.add(lid);
    lidGroupObj = { group: lid, baseY: runningY };

    applyCutawayPlane(state.xrayPct);
  }

  function applyCutawayPlane(pctRaw) {
    if (!webglReady || !clipPlane) return;
    const pct = Math.max(0, Math.min(100, Number(pctRaw) || 0));
    if (pct <= 0) {
      clipPlane.constant = 100;
      foamSectionSlices.forEach((s) => {
        s.front.visible = false;
        s.back.visible = false;
        s.bottom.visible = false;
      });
      return;
    }

    const c = 13.0 - (pct / 100) * 25.6;
    clipPlane.constant = c;
    const absC = Math.abs(c);

    foamSectionSlices.forEach((s) => {
      if (absC >= RADIUS_OUTER - 0.15) {
        s.front.visible = false;
        s.back.visible = false;
        s.bottom.visible = false;
        return;
      }
      const zOut = Math.sqrt(Math.max(0, RADIUS_OUTER * RADIUS_OUTER - c * c)) - 0.1;
      if (absC >= RADIUS_INNER) {
        const fullW = Math.max(0.1, zOut * 2);
        s.front.visible = true;
        s.front.position.set(c - 0.02, s.centerY, 0);
        s.front.scale.set(fullW, 1, 1);
        s.back.visible = false;
        s.bottom.visible = true;
        s.bottom.position.set(c - 0.02, s.bottomY, 0);
        s.bottom.scale.set(fullW, 1, 1);
      } else {
        const zIn = Math.sqrt(Math.max(0, RADIUS_INNER * RADIUS_INNER - c * c)) + 0.02;
        const wallSpan = Math.max(0.15, zOut - zIn);
        const zMid = (zOut + zIn) * 0.5;
        s.front.visible = true;
        s.front.position.set(c - 0.02, s.centerY, zMid);
        s.front.scale.set(wallSpan, 1, 1);
        s.back.visible = true;
        s.back.position.set(c - 0.02, s.centerY, -zMid);
        s.back.scale.set(wallSpan, 1, 1);
        s.bottom.visible = true;
        s.bottom.position.set(c - 0.02, s.bottomY, 0);
        s.bottom.scale.set(Math.max(0.1, zIn * 2), 1, 1);
      }
    });
  }

  function renderActiveCadPart() {
    if (!webglReady || !window.KOK_CAD_MESHES) return;
    const part = window.KOK_CAD_MESHES[state.activeCadKey];
    if (!part) return;

    disposeGroupChildren(cadInspectorGroup);
    cadInspectorGroup.rotation.y = 0;

    const geo = decodeCadGeometry(part);
    const box = geo.boundingBox;
    const size = new THREE.Vector3();
    box.getSize(size);
    const maxDim = Math.max(size.x, size.y, size.z, 0.001);
    const fitScale = 24.0 / maxDim;

    let mat;
    if (state.cadShaderMode === 'wire') {
      mat = new THREE.MeshBasicMaterial({
        color: state.env === 'dusk' ? 0xE5E7EB : 0x1E222B,
        wireframe: true
      });
    } else if (state.cadShaderMode === 'xray') {
      mat = new THREE.MeshPhysicalMaterial({
        color: 0x64748B,
        transparent: true,
        opacity: 0.42,
        roughness: 0.25,
        metalness: 0.15,
        side: THREE.DoubleSide
      });
    } else {
      mat = makeLLDPEMaterial('#1E4BD7', false);
    }

    const mesh = new THREE.Mesh(geo, mat);
    mesh.scale.setScalar(fitScale);
    mesh.position.y = Math.max(1.5, (-box.min.y * fitScale) + 0.6);
    mesh.castShadow = true;
    mesh.receiveShadow = true;
    cadInspectorGroup.add(mesh);

    if (state.cadShaderMode === 'xray') {
      const wireOverlay = new THREE.Mesh(
        geo,
        new THREE.MeshBasicMaterial({
          color: 0xD92B21,
          wireframe: true,
          transparent: true,
          opacity: 0.35
        })
      );
      wireOverlay.scale.copy(mesh.scale);
      wireOverlay.position.copy(mesh.position);
      cadInspectorGroup.add(wireOverlay);
    }

    const centerY = mesh.position.y + (box.max.y + box.min.y) * 0.5 * fitScale;
    animateCameraTo(26, Math.max(16, centerY + 10), 34, 0, Math.max(5, centerY), 0);
  }

  function animateCameraTo(cx, cy, cz, tx, ty, tz, immediate = false) {
    if (!webglReady || !camera || !controls) return;
    const endPos = new THREE.Vector3(cx, cy, cz);
    const endTarget = new THREE.Vector3(tx, ty, tz);

    if (immediate || isReducedMotion()) {
      camera.position.copy(endPos);
      controls.target.copy(endTarget);
      controls.update();
      camAnim.active = false;
      return;
    }

    camAnim.active = true;
    camAnim.startTime = performance.now();
    camAnim.startPos = camera.position.clone();
    camAnim.endPos = endPos;
    camAnim.startTarget = controls.target.clone();
    camAnim.endTarget = endTarget;
  }

  function frameCameraPreset(presetName, immediate = false) {
    const metrics = computeMetrics();
    const explodeLift = state.explodeTarget * (isV12Mode() ? 18 : metrics.tierCount * 9.0);
    const totalH = metrics.heightIn + (state.showWagon ? 2.43 : 0) + explodeLift;
    const aspect = camera && camera.aspect > 0 ? camera.aspect : 1.2;
    const isNarrow = aspect < 1.05;
    const hCenter = totalH * (isNarrow ? 0.51 : 0.48);

    const vFovRad = (camera ? camera.fov : 38) * (Math.PI / 180);
    const hFovRad = 2 * Math.atan(Math.tan(vFovRad / 2) * aspect);
    const fitH = ((totalH + 8) / (2 * Math.tan(vFovRad / 2))) * (isNarrow ? 1.92 : 1.48);
    const fitW = (30 / (2 * Math.tan(hFovRad / 2))) * 1.36;
    const dist = Math.max(58, fitH, fitW);

    if (presetName === 'top') {
      animateCameraTo(0, totalH + Math.max(36, totalH * 0.65), 16, 0, totalH - 2, 0, immediate);
    } else if (presetName === 'spigot') {
      animateCameraTo(16, 10, 34, 0, 5.5, 9, immediate);
    } else if (presetName === 'inside') {
      if (state.xrayPct === 0) {
        setXrayPct(50);
      }
      animateCameraTo(dist * 0.62, hCenter + dist * 0.16, dist * 0.56, 0, hCenter * 0.9, 0, immediate);
    } else {
      // 'three-quarter' or 'reset'
      animateCameraTo(dist * 0.54, hCenter + dist * 0.22, dist * 0.78, 0, hCenter, 0, immediate);
    }
  }

  function applyEnvironment(envKey) {
    const cfg = STUDIO_ENVS[envKey] || STUDIO_ENVS.daylight;
    state.env = envKey;
    if (viewportEl) viewportEl.dataset.studioEnv = envKey;

    document.querySelectorAll('[data-env]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.env === envKey));
    });

    if (!webglReady) return;
    scene.background.setHex(cfg.bg);
    scene.fog.color.setHex(cfg.fog);
    scene.fog.density = cfg.fogDensity;
    hemiLight.color.setHex(cfg.hemiSky);
    hemiLight.groundColor.setHex(cfg.hemiGround);
    hemiLight.intensity = cfg.hemiInt;
    keyLight.color.setHex(cfg.keyColor);
    keyLight.intensity = cfg.keyInt;
    fillLight.color.setHex(cfg.fillColor);
    fillLight.intensity = cfg.fillInt;
    rimLight.color.setHex(cfg.rimColor);
    rimLight.intensity = cfg.rimInt;
    floorMat.opacity = cfg.shadowOpacity;
    floorRingMats.forEach((m) => m.color.setHex(cfg.ringColor));

    if (state.mode === 'cad-part' && state.cadShaderMode === 'wire') {
      renderActiveCadPart();
    }
  }

  function initThreeViewport() {
    if (!window.THREE || !window.THREE.OrbitControls || !canvasEl || !viewportEl) {
      if (fallbackEl) fallbackEl.hidden = false;
      return;
    }

    try {
      scene = new THREE.Scene();
      scene.background = new THREE.Color(STUDIO_ENVS.daylight.bg);
      scene.fog = new THREE.FogExp2(STUDIO_ENVS.daylight.fog, STUDIO_ENVS.daylight.fogDensity);

      const w = Math.max(viewportEl.clientWidth, 320);
      const h = Math.max(viewportEl.clientHeight, 320);

      camera = new THREE.PerspectiveCamera(38, w / h, 0.25, 800);
      camera.position.set(58, 56, 74);

      renderer = new THREE.WebGLRenderer({
        canvas: canvasEl,
        antialias: true,
        preserveDrawingBuffer: true
      });
      renderer.setSize(w, h, false);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;
      renderer.localClippingEnabled = true;

      clipPlane = new THREE.Plane(new THREE.Vector3(-1, 0, 0), 100);
      clipPlaneArray = [clipPlane];

      controls = new THREE.OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;
      controls.dampingFactor = 0.06;
      controls.maxPolarAngle = Math.PI / 2 - 0.02;
      controls.minDistance = 22;
      controls.maxDistance = 360;
      controls.target.set(0, 26, 0);
      controls.addEventListener('start', () => {
        camAnim.active = false;
        hasUserOrbited = true;
      });

      // Architectural Neutral Studio Lights
      hemiLight = new THREE.HemisphereLight(
        STUDIO_ENVS.daylight.hemiSky,
        STUDIO_ENVS.daylight.hemiGround,
        STUDIO_ENVS.daylight.hemiInt
      );
      scene.add(hemiLight);

      keyLight = new THREE.DirectionalLight(STUDIO_ENVS.daylight.keyColor, STUDIO_ENVS.daylight.keyInt);
      keyLight.position.set(58, 96, 54);
      keyLight.castShadow = true;
      keyLight.shadow.mapSize.width = 2048;
      keyLight.shadow.mapSize.height = 2048;
      keyLight.shadow.camera.near = 10;
      keyLight.shadow.camera.far = 260;
      keyLight.shadow.camera.left = -48;
      keyLight.shadow.camera.right = 48;
      keyLight.shadow.camera.top = 92;
      keyLight.shadow.camera.bottom = -48;
      keyLight.shadow.bias = -0.0004;
      scene.add(keyLight);

      fillLight = new THREE.DirectionalLight(STUDIO_ENVS.daylight.fillColor, STUDIO_ENVS.daylight.fillInt);
      fillLight.position.set(-56, 44, 34);
      scene.add(fillLight);

      rimLight = new THREE.DirectionalLight(STUDIO_ENVS.daylight.rimColor, STUDIO_ENVS.daylight.rimInt);
      rimLight.position.set(-16, 62, -64);
      scene.add(rimLight);

      // Seamless Cyclorama Shadow Floor (zero horizon seam)
      floorMat = new THREE.ShadowMaterial({
        color: 0x0A0A0A,
        opacity: STUDIO_ENVS.daylight.shadowOpacity
      });
      floorMesh = new THREE.Mesh(new THREE.PlaneGeometry(600, 600), floorMat);
      floorMesh.rotation.x = -Math.PI / 2;
      floorMesh.position.y = -0.02;
      floorMesh.receiveShadow = true;
      scene.add(floorMesh);

      buildArchitecturalFloorMarkings();
      lldpeBumpTex = generateStippleBumpTexture();

      coolerRoot = new THREE.Group();
      scene.add(coolerRoot);

      wagonGroup = new THREE.Group();
      modularGroup = new THREE.Group();
      v12AssemblyGroup = new THREE.Group();
      cadInspectorGroup = new THREE.Group();
      cadInspectorGroup.visible = false;

      coolerRoot.add(wagonGroup, modularGroup, v12AssemblyGroup);
      scene.add(cadInspectorGroup);

      webglReady = true;
      if (fallbackEl) fallbackEl.hidden = true;

      rebuildCoolerScene();
      frameCameraPreset('three-quarter', true);

      const handleResize = () => {
        if (!webglReady) return;
        const rw = viewportEl.clientWidth;
        const rh = viewportEl.clientHeight;
        if (rw <= 0 || rh <= 0) return;
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        camera.aspect = rw / rh;
        camera.updateProjectionMatrix();
        renderer.setSize(rw, rh, false);
        if (!hasUserOrbited && state.mode !== 'cad-part') {
          frameCameraPreset('three-quarter', true);
        }
      };

      window.addEventListener('resize', handleResize, { passive: true });
      if (typeof ResizeObserver !== 'undefined') {
        new ResizeObserver(handleResize).observe(viewportEl);
      }

      // Render Loop with Damped Spring Explode Physics
      let lastTs = performance.now();
      function renderLoop(now) {
        requestAnimationFrame(renderLoop);
        const dt = Math.min((now - lastTs) / 1000, 0.05);
        lastTs = now;

        // Damped second-order spring for smooth explode separation
        if (isReducedMotion()) {
          explodeVal = state.explodeTarget;
          explodeVel = 0;
        } else {
          const stiffness = 145;
          const damping = 19;
          const accel = (state.explodeTarget - explodeVal) * stiffness - explodeVel * damping;
          explodeVel += accel * dt;
          explodeVal += explodeVel * dt;
          if (Math.abs(state.explodeTarget - explodeVal) < 0.0005 && Math.abs(explodeVel) < 0.0005) {
            explodeVal = state.explodeTarget;
            explodeVel = 0;
          }
        }

        if (state.mode === 'modular') {
          const gapPerTier = 9.0;
          const twistScale = state.xrayPct > 0 ? 0 : Math.min(explodeVal * 1.4, 1);
          for (let i = 0; i < tierGroups.length; i++) {
            const tg = tierGroups[i];
            tg.group.position.y = tg.baseY + i * explodeVal * gapPerTier;
            // Subtle 18-degree twist-lock unlock rotation on upper tiers as they lift (suppressed when cutaway slice is active)
            if (i > 0) {
              const dir = i % 2 === 1 ? 1 : -1;
              tg.group.rotation.y = dir * twistScale * (Math.PI / 10);
            }
          }
          if (lidGroupObj.group) {
            lidGroupObj.group.position.y = lidGroupObj.baseY + tierGroups.length * explodeVal * gapPerTier;
            lidGroupObj.group.rotation.y = twistScale * (Math.PI / 10);
          }
        } else if (isV12Mode()) {
          for (let i = 0; i < v12ExplodableMeshes.length; i++) {
            const m = v12ExplodableMeshes[i];
            if (m && m.userData) {
              m.position.y = m.userData.baseY + explodeVal * m.userData.explodeDeltaY;
            }
          }
        }

        // Smooth eased camera preset transition
        if (camAnim.active) {
          const progress = Math.min((now - camAnim.startTime) / camAnim.duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          camera.position.lerpVectors(camAnim.startPos, camAnim.endPos, eased);
          controls.target.lerpVectors(camAnim.startTarget, camAnim.endTarget, eased);
          if (progress >= 1) camAnim.active = false;
        }

        // Auto-Turntable rotation
        if (state.turntable && !isReducedMotion()) {
          if (state.mode === 'cad-part') {
            cadInspectorGroup.rotation.y += 0.42 * dt;
          } else {
            coolerRoot.rotation.y += 0.34 * dt;
          }
        }

        controls.update();
        renderer.render(scene, camera);
      }
      requestAnimationFrame(renderLoop);
    } catch (err) {
      console.warn('3D Studio WebGL fallback:', err);
      webglReady = false;
      if (fallbackEl) fallbackEl.hidden = false;
    }
  }

