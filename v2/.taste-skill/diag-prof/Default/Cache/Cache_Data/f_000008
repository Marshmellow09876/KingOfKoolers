  function updateTripErgonomics() {
    const m = computeMetrics();
    const party = state.partySize;
    const days = state.tripDays;
    if (partyVal) partyVal.textContent = `${party} ${party === 1 ? 'Adult' : 'Adults'}`;
    if (daysVal) daysVal.textContent = `${days} ${days === 1 ? 'Day' : 'Days'}`;

    const cansNeeded = party * days * 4;
    const iceNeeded = Math.round(cansNeeded * 0.8);
    const drinksLbs = Math.round(cansNeeded * 0.78);

    if (calcCansResult) calcCansResult.textContent = `${cansNeeded} Cans`;
    if (calcIceResult) calcIceResult.textContent = `${iceNeeded} lbs Crushed Ice`;

    let recKey = 'scout-30';
    if (cansNeeded <= 36) recKey = 'scout-30';
    else if (cansNeeded <= 72) recKey = 'explorer-38';
    else if (cansNeeded <= 140) recKey = 'patriot-58';
    else recKey = 'titan-72';

    if (calcStackResult) {
      calcStackResult.textContent = STACK_PRESETS[recKey].label;
      calcStackResult.dataset.recKey = recKey;
    }

    const grossTripLbs = m.dryLbs + iceNeeded + drinksLbs;
    const grossKg = (grossTripLbs * 0.453592).toFixed(1);
    if (ergoTripLbs) ergoTripLbs.textContent = `${grossTripLbs} lbs`;
    if (ergoTripKg) ergoTripKg.textContent = `${grossKg} kg`;
    if (ergoDryVal) ergoDryVal.textContent = `${m.dryLbs} lbs`;
    if (ergoIceVal) ergoIceVal.textContent = `${iceNeeded} lbs`;
    if (ergoDrinksVal) ergoDrinksVal.textContent = `${drinksLbs} lbs`;

    if (ergoMeterFill) {
      ergoMeterFill.style.width = `${Math.min(100, (grossTripLbs / 220) * 100)}%`;
    }
    if (ergoStatusBox) {
      ergoStatusBox.classList.remove('is-warn', 'is-heavy');
      if (grossTripLbs < 45) {
        ergoStatusBox.textContent = 'Solo Carry (<45 lbs): Comfortably portable by one person.';
      } else if (grossTripLbs <= 110) {
        ergoStatusBox.classList.add('is-warn');
        ergoStatusBox.textContent = 'Two-Person Team Lift (45–110 lbs): Use opposing molded side loop handles (200 lb rated each).';
      } else {
        ergoStatusBox.classList.add('is-heavy');
        ergoStatusBox.textContent = 'Heavy Expedition Load (>110 lbs): Unthread tiers before lifting or mount the 3-Wheel Wagon Dolly Base.';
      }
    }
