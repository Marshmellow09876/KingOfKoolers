  function decodeCadGeometry(part) {
    if (!part) return null;
    if (cadGeometryCache.has(part.key)) {
      return cadGeometryCache.get(part.key);
    }
    const vBin = atob(part.vB64);
    const vBytes = new Uint8Array(vBin.length);
    for (let i = 0; i < vBin.length; i++) vBytes[i] = vBin.charCodeAt(i);
    const i16 = new Int16Array(vBytes.buffer);
    const pos = new Float32Array(i16.length);
    const invScale = part.scaleHalfExt / 32760.0;
    for (let i = 0; i < i16.length; i++) pos[i] = i16[i] * invScale;

    const tBin = atob(part.tB64);
    const tBytes = new Uint8Array(tBin.length);
    for (let i = 0; i < tBin.length; i++) tBytes[i] = tBin.charCodeAt(i);
    const u16 = new Uint16Array(tBytes.buffer);

    const geo = new THREE.BufferGeometry();
    geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    geo.setIndex(new THREE.BufferAttribute(u16, 1));
    geo.computeVertexNormals();
    geo.computeBoundingBox();
    geo.userData.isSharedCad = true;
    cadGeometryCache.set(part.key, geo);
    return geo;
  }

  function disposeGroupChildren(group) {
    if (!group) return;
    while (group.children.length > 0) {
      const child = group.children[0];
      group.remove(child);
      child.traverse((obj) => {
        if (obj.geometry && !obj.geometry.userData?.isSharedCad) {
          obj.geometry.dispose();
        }
        if (obj.material) {
          if (Array.isArray(obj.material)) {
            obj.material.forEach((m) => {
              if (m.map && m.map !== lldpeBumpTex) m.map.dispose();
              m.dispose();
            });
          } else {
            if (obj.material.map && obj.material.map !== lldpeBumpTex) obj.material.map.dispose();
            obj.material.dispose();
          }
        }
      });
    }
  }

  function buildArchitecturalFloorMarkings() {
    floorMarkingsGroup = new THREE.Group();
    floorRingMats = [];

    const createCircleLine = (radius, opacity = 0.85) => {
      const pts = [];
      const segs = 96;
      for (let i = 0; i <= segs; i++) {
        const a = (i / segs) * Math.PI * 2;
        pts.push(new THREE.Vector3(Math.cos(a) * radius, 0.02, Math.sin(a) * radius));
      }
      const geo = new THREE.BufferGeometry().setFromPoints(pts);
      const mat = new THREE.LineBasicMaterial({
        color: STUDIO_ENVS.daylight.ringColor,
        transparent: true,
        opacity
      });
      floorRingMats.push(mat);
      return new THREE.LineLoop(geo, mat);
    };

    floorMarkingsGroup.add(createCircleLine(12.2, 0.95)); // 24.0" OD datum ring
    floorMarkingsGroup.add(createCircleLine(18.0, 0.72)); // 36" handle clearance ring
    floorMarkingsGroup.add(createCircleLine(28.0, 0.52)); // 56" studio stage ring

    const crossMat = new THREE.LineBasicMaterial({
      color: STUDIO_ENVS.daylight.ringColor,
      transparent: true,
      opacity: 0.55
    });
    floorRingMats.push(crossMat);

    const axisX = new THREE.BufferGeometry().setFromPoints([
      new THREE.Vector3(-32, 0.018, 0),
      new THREE.Vector3(32, 0.018, 0)
    ]);
    const axisZ = new THREE.BufferGeometry().setFromPoints([
      new THREE.Vector3(0, 0.018, -32),
