  // =========================================================================
  // 9. Accessible Single-Row Tabs + beforematch Support
  // =========================================================================
  const tabButtons = [...document.querySelectorAll('.rail-tab[role="tab"]')];
  const tabPanels = [...document.querySelectorAll('.rail-tabpanel[role="tabpanel"]')];

  function activateTab(panelId, moveFocus = false) {
    const targetBtn = tabButtons.find((b) => b.dataset.panel === panelId);
    if (!targetBtn) return;

    state.activeTabId = panelId;
    tabButtons.forEach((btn) => {
      const selected = btn === targetBtn;
      btn.setAttribute('aria-selected', String(selected));
      btn.tabIndex = selected ? 0 : -1;
    });

    tabPanels.forEach((panel) => {
      const match = panel.id === panelId;
      panel.hidden = match ? false : 'until-found';
    });

    targetBtn.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    if (moveFocus) targetBtn.focus();

    if (panelId === 'panel-cad') {
      if (state.mode !== 'cad-part') {
        state.mode = 'cad-part';
        rebuildCoolerScene();
        syncReadoutAndHUD();
        updateCadTelemetryUI();
      }
    } else if (state.mode === 'cad-part') {
      exitCadInspectorMode();
    }
  }

  function exitCadInspectorMode() {
    state.mode = state.activePresetKey === 'v12-split' || state.activePresetKey === 'v12-onepiece'
      ? state.activePresetKey
      : 'modular';
    rebuildCoolerScene();
    syncAllUI();
    frameCameraPreset('three-quarter');
  }

  tabButtons.forEach((btn, idx) => {
    btn.addEventListener('click', () => activateTab(btn.dataset.panel, false));
    btn.addEventListener('keydown', (e) => {
      let nextIdx = null;
      if (e.key === 'ArrowRight') nextIdx = (idx + 1) % tabButtons.length;
      else if (e.key === 'ArrowLeft') nextIdx = (idx - 1 + tabButtons.length) % tabButtons.length;
      else if (e.key === 'Home') nextIdx = 0;
      else if (e.key === 'End') nextIdx = tabButtons.length - 1;
      if (nextIdx !== null) {
        e.preventDefault();
        activateTab(tabButtons[nextIdx].dataset.panel, true);
      }
    });
  });

  tabPanels.forEach((panel) => {
    panel.addEventListener('beforematch', () => activateTab(panel.id, false));
  });

