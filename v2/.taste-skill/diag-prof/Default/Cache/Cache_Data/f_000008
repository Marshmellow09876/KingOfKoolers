  function createFoamCutawaySlices(height, tierGroup, baseOffsetY) {
    const sliceMat = new THREE.MeshStandardMaterial({
      color: 0xD69E36,
      roughness: 0.88,
      metalness: 0.02,
      side: THREE.DoubleSide
    });
    const sliceFront = new THREE.Mesh(new THREE.PlaneGeometry(1, Math.max(1, height - 0.16)), sliceMat);
    sliceFront.rotation.y = Math.PI / 2;
    sliceFront.visible = false;
    tierGroup.add(sliceFront);

    const sliceBack = new THREE.Mesh(new THREE.PlaneGeometry(1, Math.max(1, height - 0.16)), sliceMat);
    sliceBack.rotation.y = Math.PI / 2;
    sliceBack.visible = false;
    tierGroup.add(sliceBack);

    const sliceBottom = new THREE.Mesh(new THREE.PlaneGeometry(1, 1.1), sliceMat);
    sliceBottom.rotation.y = Math.PI / 2;
    sliceBottom.position.y = baseOffsetY + 0.55;
    sliceBottom.visible = false;
    tierGroup.add(sliceBottom);

    foamSectionSlices.push({
      front: sliceFront,
      back: sliceBack,
      bottom: sliceBottom,
      height,
      centerY: baseOffsetY + height / 2,
      bottomY: baseOffsetY + 0.55
    });
  }

  function buildModularTier(tier, index, totalTiers) {
    const H = tier.height;
    const cat = TIERS_CATALOG[H] || TIERS_CATALOG[20];
    const hex = COLORWAYS[tier.color]?.hex || '#1E4BD7';
    const shellMat = makeLLDPEMaterial(hex, true);
    const tierGroup = new THREE.Group();

    const cad = window.KOK_CAD_MESHES || null;
    const hasFullCadRings = Boolean(
      cad &&
      cad.v12_sec1_foot &&
      cad.v12_sec2_lower &&
      cad.v12_sec3_mid &&
      cad.v12_sec4_handles &&
      cad.v12_sec5_collar
    );

    // Product Continuity Rule: Drain spigot strictly on 20" & 28" base modules (never 12" or 18")
    const renderSpigot = Boolean(cat.allowsSpigot && index === 0 && state.showSpigot);

    if (hasFullCadRings) {
      // 1. Concentric Indexing Foot (0.00" -> 0.92")
      const footGeo = decodeCadGeometry(cad.v12_sec1_foot);
      const footMesh = new THREE.Mesh(footGeo, shellMat);
      footMesh.scale.set(MM_TO_IN, MM_TO_IN, MM_TO_IN);
      footMesh.position.set(0, 0.46, 0);
      footMesh.castShadow = true;
      footMesh.receiveShadow = true;
      tierGroup.add(footMesh);

      const handleRingBottom = H - 4.39;
      if (renderSpigot) {
        // 2a. Lower Body w/ Integrated Spigot Boss (0.92" -> 8.21")
        const lowGeo = decodeCadGeometry(cad.v12_sec2_lower);
        const lowMesh = new THREE.Mesh(lowGeo, shellMat);
        lowMesh.scale.set(MM_TO_IN, MM_TO_IN, MM_TO_IN);
        lowMesh.position.set(0, 4.56, 1.18);
        lowMesh.castShadow = true;
        lowMesh.receiveShadow = true;
        tierGroup.add(lowMesh);

        // Precision Quarter-Turn Spigot Valve
        const spigot = buildSpigotValveAssembly();
        spigot.position.set(0, 3.35, 13.0);
        tierGroup.add(spigot);

        // 2b. Smooth Mid Wall Extension (8.21" -> handleRingBottom)
        const midSpan = Math.max(1.0, handleRingBottom - 8.21);
        const midGeo = decodeCadGeometry(cad.v12_sec3_mid);
        const midMesh = new THREE.Mesh(midGeo, shellMat);
        midMesh.scale.set(MM_TO_IN, MM_TO_IN * (midSpan / 7.4), MM_TO_IN);
        midMesh.position.set(0, 8.21 + midSpan * 0.5, 0);
        midMesh.castShadow = true;
        midMesh.receiveShadow = true;
        tierGroup.add(midMesh);
      } else {
        // 2. Spigot-Free Seamless Mid Cylindrical Wall (0.92" -> handleRingBottom)
        const midSpan = Math.max(1.2, handleRingBottom - 0.92);
        const midGeo = decodeCadGeometry(cad.v12_sec3_mid);
        const midMesh = new THREE.Mesh(midGeo, shellMat);
        midMesh.scale.set(MM_TO_IN, MM_TO_IN * (midSpan / 7.4), MM_TO_IN);
        midMesh.position.set(0, 0.92 + midSpan * 0.5, 0);
        midMesh.castShadow = true;
        midMesh.receiveShadow = true;
        tierGroup.add(midMesh);
      }

      // 3. Upper Molded Loop Handles Ring (H - 4.395" -> H - 0.925")
      const handleGeo = decodeCadGeometry(cad.v12_sec4_handles);
      const handleMesh = new THREE.Mesh(handleGeo, shellMat);
      handleMesh.scale.set(MM_TO_IN, MM_TO_IN, MM_TO_IN);
      handleMesh.position.set(0, H - 2.66, 0);
      handleMesh.castShadow = true;
      handleMesh.receiveShadow = true;
      tierGroup.add(handleMesh);

      // 4. Top 20-Start Twist-Lock Bayonet Collar Rim (H - 1.48" -> H)
      const collarGeo = decodeCadGeometry(cad.v12_sec5_collar);
      const collarMesh = new THREE.Mesh(collarGeo, shellMat);
      collarMesh.scale.set(MM_TO_IN, MM_TO_IN, MM_TO_IN);
      collarMesh.position.set(0, H - 0.74, 0);
      collarMesh.castShadow = true;
      collarMesh.receiveShadow = true;
      tierGroup.add(collarMesh);
    } else {
      // Parametric Procedural Fallback Cylinder Tier (when CAD bundle unavailable)
      const outerGeo = new THREE.CylinderGeometry(RADIUS_OUTER, RADIUS_OUTER, H, 56, 1, true);
      const outerMesh = new THREE.Mesh(outerGeo, shellMat);
      outerMesh.position.y = H / 2;
      outerMesh.castShadow = true;
      outerMesh.receiveShadow = true;
      tierGroup.add(outerMesh);

      const outerBottom = new THREE.Mesh(new THREE.CircleGeometry(RADIUS_OUTER, 56), shellMat);
      outerBottom.rotation.x = Math.PI / 2;
      outerBottom.position.y = 0.05;
      tierGroup.add(outerBottom);

      const collarRing = new THREE.Mesh(new THREE.TorusGeometry(RADIUS_OUTER - 0.15, 0.58, 12, 56), shellMat);
      collarRing.rotation.x = Math.PI / 2;
      collarRing.position.y = H - 0.58;
      tierGroup.add(collarRing);

      const handleGeo = new THREE.TorusGeometry(2.3, 0.52, 12, 24, Math.PI);
      const hLeft = new THREE.Mesh(handleGeo, shellMat);
      hLeft.rotation.order = 'YXZ';
      hLeft.rotation.x = Math.PI / 2;
      hLeft.rotation.y = -Math.PI / 2;
      hLeft.position.set(-RADIUS_OUTER + 0.35, H - 2.6, 0);
      hLeft.castShadow = true;
      tierGroup.add(hLeft);

      const hRight = new THREE.Mesh(handleGeo, shellMat);
      hRight.rotation.order = 'YXZ';
      hRight.rotation.x = Math.PI / 2;
      hRight.rotation.y = Math.PI / 2;
      hRight.position.set(RADIUS_OUTER - 0.35, H - 2.6, 0);
      hRight.castShadow = true;
      tierGroup.add(hRight);

      const foot = new THREE.Mesh(new THREE.CylinderGeometry(RADIUS_OUTER - 1.1, RADIUS_OUTER - 1.1, 0.9, 48), shellMat);
      foot.position.y = 0.45;
      tierGroup.add(foot);

      if (renderSpigot) {
        const spigot = buildSpigotValveAssembly();
        spigot.position.set(0, 3.35, RADIUS_OUTER + 0.7);
        tierGroup.add(spigot);
      }
    }

    // Inner Food-Grade Liner & Insulated Base Floor (Clipped for Cutaway)
    const linerMat = new THREE.MeshStandardMaterial({
      color: 0xF0F4FA,
      roughness: 0.42,
      metalness: 0.02,
      clippingPlanes: clipPlaneArray,
      side: THREE.DoubleSide
    });
    const innerCylinder = new THREE.Mesh(
      new THREE.CylinderGeometry(RADIUS_INNER, RADIUS_INNER, Math.max(2, H - 1.35), 48, 1, true),
      linerMat
    );
    innerCylinder.position.y = H / 2 + 0.38;
    innerCylinder.castShadow = false;
    innerCylinder.receiveShadow = false;
    tierGroup.add(innerCylinder);

    const innerFloor = new THREE.Mesh(new THREE.CircleGeometry(RADIUS_INNER, 48), linerMat);
    innerFloor.rotation.x = -Math.PI / 2;
    innerFloor.position.y = 1.05;
    innerFloor.receiveShadow = false;
    tierGroup.add(innerFloor);

    // Top R-8 Foam Collar Annulus (exposed in Cutaway or Explode)
    const foamMat = new THREE.MeshStandardMaterial({
      color: 0xD69E36,
      roughness: 0.88,
      metalness: 0.02,
      clippingPlanes: clipPlaneArray,
      side: THREE.DoubleSide
    });
    const foamRing = new THREE.Mesh(new THREE.RingGeometry(RADIUS_INNER, 11.72, 48), foamMat);
    foamRing.rotation.x = -Math.PI / 2;
    foamRing.position.y = H - 0.25;
    tierGroup.add(foamRing);

    // Dual-Barrier Hermetic Gasket System (Black EPDM Lip + Patriot Red Silicone O-Ring)
    const epdmMat = new THREE.MeshStandardMaterial({
      color: 0x1A1D22,
      roughness: 0.82,
      metalness: 0.02,
      clippingPlanes: clipPlaneArray
    });
    const epdmRing = new THREE.Mesh(new THREE.TorusGeometry(11.15, 0.2, 10, 56), epdmMat);
    epdmRing.rotation.x = Math.PI / 2;
    epdmRing.position.y = H - 0.08;
    tierGroup.add(epdmRing);

    const redOSealMat = new THREE.MeshStandardMaterial({
      color: 0xD92B21,
      roughness: 0.48,
      metalness: 0.04,
      clippingPlanes: clipPlaneArray
    });
    const oRing = new THREE.Mesh(new THREE.TorusGeometry(10.82, 0.11, 8, 56), redOSealMat);
    oRing.rotation.x = Math.PI / 2;
    oRing.position.y = H - 0.22;
    tierGroup.add(oRing);

    // Dynamic Cutaway Foam Cross-Section Caps
    createFoamCutawaySlices(H, tierGroup, 0);

    // Front Wall Laser Engraving Badge (when 'body' placement active on base tier)
    if (index === 0 && state.engraveLoc === 'body' && (state.engraveLine1.trim() || state.engraveLine2.trim() || state.customLogoImg)) {
      const bodyTex = generateEngraveTexture('body', hex);
      const badgeGeo = new THREE.CylinderGeometry(
        RADIUS_OUTER + 0.08,
        RADIUS_OUTER + 0.08,
        Math.min(H * 0.45, 7.2),
        36,
        1,
        true,
        -Math.PI / 5,
        (Math.PI * 2) / 5
      );
      const badgeMat = new THREE.MeshStandardMaterial({
        map: bodyTex,
        roughness: 0.7,
        clippingPlanes: clipPlaneArray,
        side: THREE.DoubleSide
      });
      const badge = new THREE.Mesh(badgeGeo, badgeMat);
      badge.position.y = H * 0.56;
      badge.rotation.y = renderSpigot ? Math.PI : 0; // avoid front spigot boss if present
      tierGroup.add(badge);
    }

    // Internal Hardware inside Base Tier (Ice Bed, Craft Cans, All-Thread Deli Carousel)
    if (index === 0) {
      if (state.showCarousel) {
        addInternalCarousel(tierGroup, H);
      }
      if (state.showIceAndCans) {
        addInternalIceAndCans(tierGroup, H);
      }
    } else if (state.showCarousel && index === totalTiers - 1 && H >= 12) {
      // Optional upper carousel tray inside upper tier
      addUpperCarouselTray(tierGroup, H);
    }

    return tierGroup;
  }

