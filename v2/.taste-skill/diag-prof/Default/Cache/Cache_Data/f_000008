  function renderTierComposer() {
    if (!tierListEl) return;
    const metrics = computeMetrics();
    const totalHeight = metrics.heightIn;

    if (heightLimitReadout) {
      heightLimitReadout.textContent = `${totalHeight}" / ${MAX_STACK_HEIGHT}" max`;
