      downBtn.title = 'Move tier down';
      downBtn.setAttribute('aria-label', `Move ${cat.name} down`);
      downBtn.disabled = isBase || isV12Mode();
      downBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      downBtn.addEventListener('click', () => moveTier(idx, idx - 1));

      const delBtn = document.createElement('button');
      delBtn.type = 'button';
      delBtn.className = 'tier-ctrl-btn v2-pressable';
      delBtn.title = 'Remove tier';
      delBtn.setAttribute('aria-label', `Remove ${cat.name}`);
      delBtn.disabled = state.tiers.length <= 1 || isV12Mode();
      delBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 4.5l7 7M11.5 4.5l-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>';
      delBtn.addEventListener('click', () => removeTier(idx));

      ctrlWrap.append(upBtn, downBtn, delBtn);
      li.append(selectBtn, ctrlWrap);
      tierListEl.appendChild(li);
    }

    // Update Add Tier button availability against 72" max stack limit
    let anyBlocked = false;
    document.querySelectorAll('[data-add-tier]').forEach((btn) => {
      const addH = Number(btn.dataset.addTier);
      const effectiveCurrent = isV12Mode() ? 0 : totalHeight;
      const exceeds = effectiveCurrent + addH > MAX_STACK_HEIGHT;
      btn.disabled = exceeds;
      if (exceeds) anyBlocked = true;
    });

    if (stackLimitNote) {
      if (isV12Mode()) {
        stackLimitNote.textContent = 'Adding any modular tier switches from V12 CAD prototype to modular stack composer.';
        stackLimitNote.classList.remove('group-note--warn');
      } else if (totalHeight >= MAX_STACK_HEIGHT) {
        stackLimitNote.textContent = '72" maximum stack height reached. Remove or resize a tier to add another.';
        stackLimitNote.classList.add('group-note--warn');
      } else if (anyBlocked) {
        const rem = MAX_STACK_HEIGHT - totalHeight;
        stackLimitNote.textContent = `${rem}" remaining before 72" maximum stack ceiling.`;
        stackLimitNote.classList.remove('group-note--warn');
      } else {
        stackLimitNote.textContent = `${MAX_STACK_HEIGHT - totalHeight}" headroom available under the 72" vertical limit.`;
        stackLimitNote.classList.remove('group-note--warn');
      }
    }
  }

