  function hasBaseSpigotCapability() {
    if (isV12Mode()) {
      return state.v12HeightIn >= 20;
    }
    const baseTier = state.tiers[0];
    return Boolean(baseTier && TIERS_CATALOG[baseTier.height]?.allowsSpigot);
  }

  function computeMetrics() {
    const lid = LID_MODULES[state.lidModule] || LID_MODULES.solar;
    const wagonPrice = state.showWagon ? WAGON_PRICE : 0;
    const wagonLbs = state.showWagon ? WAGON_WEIGHT : 0;
    const hasEngraving = Boolean(state.engraveLine1.trim() || state.engraveLine2.trim() || state.customLogoImg);
    const engravePrice = hasEngraving ? ENGRAVE_PRICE : 0;

    if (isV12Mode()) {
      const spec = V12_HEIGHT_SPECS[state.v12HeightIn] || V12_HEIGHT_SPECS[20];
      const heightIn = state.v12HeightIn;
      const heightCm = +(heightIn * 2.54).toFixed(1);
      const dryLbs = spec.dryLbs + (lid.weightLbs - 4) + wagonLbs;
      const fullLoadedLbs = dryLbs + spec.iceLbs + Math.round(spec.cans * 0.82);
      const totalPrice = spec.price + lid.price + wagonPrice + engravePrice;
      return {
        heightIn,
        heightCm,
        quarts: spec.quarts,
        cans: spec.cans,
        iceLbs: spec.iceLbs,
        dryLbs,
        fullLoadedLbs,
        totalPrice,
        tierCount: 1,
        spigotActive: hasBaseSpigotCapability() && state.showSpigot,
        hasEngraving
      };
    }

    let heightIn = 0;
    let quarts = 0;
    let cans = 0;
    let iceLbs = 0;
    let dryTiersLbs = 0;
    let tiersPrice = 0;

    for (const tier of state.tiers) {
      const cat = TIERS_CATALOG[tier.height];
      if (!cat) continue;
      heightIn += cat.height;
      quarts += cat.quarts;
      cans += cat.cans;
      iceLbs += cat.iceLbs;
      dryTiersLbs += cat.dryLbs;
      tiersPrice += cat.price;
    }

    const heightCm = +(heightIn * 2.54).toFixed(1);
    const dryLbs = dryTiersLbs + lid.weightLbs + wagonLbs;
    const fullLoadedLbs = dryLbs + iceLbs + Math.round(cans * 0.82);
    const totalPrice = tiersPrice + lid.price + wagonPrice + engravePrice;

    return {
      heightIn,
      heightCm,
      quarts,
      cans,
      iceLbs,
      dryLbs,
      fullLoadedLbs,
      totalPrice,
      tierCount: state.tiers.length,
      spigotActive: hasBaseSpigotCapability() && state.showSpigot,
      hasEngraving
    };
  }

